    const weaponTypes = [
      { id: "lança", name: "Lança", icon: "🗡️", effect: "+1 Ponto", val: 1, type: "buff" },
      { id: "pistola", name: "Pistola", icon: "🔫", effect: "+2 Pontos", val: 2, type: "buff" },
      { id: "ak47", name: "AK-47", icon: "🛡️", effect: "Vitória Direta", val: 0, type: "win" },
      { id: "metralhadora", name: "Metralhadora", icon: "💥", effect: "-3 Oponente", val: -3, type: "debuff" }
    ];

    let gameState = {
      selectedCountry: null,
      playerWeapons: [],
      cpuWeapons: [],
      playerSlots: [null, null, null, null, null],
      playerWeaponSlots: [null, null, null, null, null],
      cpuSlots: [1, 2, 3, 4, 5],
      cpuWeaponSlots: [null, null, null, null, null],
      selectedWeaponIndex: null,
      dockUsed: [false, false, false, false, false]
    };

    function showScreen(id) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      document.getElementById(id).classList.add('active');
    }

    function exitGame() {
      alert("Obrigado por jogar!");
      window.close();
    }

    function startRoulettePhase() {
      showScreen('screen-roulette');
      document.getElementById('history-card').classList.remove('active');
      document.getElementById('spin-btn').style.display = 'inline-block';
    }

    function spinWheel() {
      const wheel = document.getElementById('wheel');
      const btn = document.getElementById('spin-btn');
      btn.style.display = 'none';

      // Sorteio 100% Uniforme entre os 193
      const randomIndex = Math.floor(Math.random() * countriesData.length);
      gameState.selectedCountry = countriesData[randomIndex];

      const randomRounds = 5 + Math.floor(Math.random() * 5);
      const randomDegrees = Math.floor(Math.random() * 360);
      const totalRotation = (randomRounds * 360) + randomDegrees;

      wheel.style.transform = `rotate(${totalRotation}deg)`;

      setTimeout(() => {
        const c = gameState.selectedCountry;
        document.getElementById('country-name').innerText = c.name;
        document.getElementById('indep-year').innerText = c.year;
        document.getElementById('rival-name').innerText = c.rival;
        document.getElementById('country-story').innerText = c.story;
        document.getElementById('history-card').classList.add('active');
      }, 5000);
    }

    function goToArmory() {
      // Sorteia 2 armas pro player e 2 pra CPU
      let pool = [...weaponTypes];
      pool.sort(() => Math.random() - 0.5);
      gameState.playerWeapons = [pool[0], pool[1]];
      gameState.cpuWeapons = [pool[2], pool[3]];

      // CPU coloca automaticamente suas cartas
      let availableSlots = [0, 1, 2, 3, 4].sort(() => Math.random() - 0.5);
      gameState.cpuWeaponSlots[availableSlots[0]] = gameState.cpuWeapons[0];
      gameState.cpuWeaponSlots[availableSlots[1]] = gameState.cpuWeapons[1];
      gameState.cpuSlots.sort(() => Math.random() - 0.5);

      renderArmory();
      showScreen('screen-positioning');
    }

    function renderArmory() {
      const wContainer = document.getElementById('player-weapons');
      wContainer.innerHTML = '';
      gameState.playerWeapons.forEach((w, idx) => {
        const div = document.createElement('div');
        div.className = `weapon-card ${gameState.selectedWeaponIndex === idx ? 'selected' : ''} ${w.used ? 'used' : ''}`;
        div.innerHTML = `<div class="weapon-icon">${w.icon}</div><div class="weapon-name">${w.name}</div><div class="weapon-effect">${w.effect}</div>`;
        div.onclick = () => {
          if (!w.used) {
            gameState.selectedWeaponIndex = (gameState.selectedWeaponIndex === idx) ? null : idx;
            renderArmory();
          }
        };
        wContainer.appendChild(div);
      });

      const dock = document.getElementById('soldiers-dock');
      dock.innerHTML = '';
      for (let i = 1; i <= 5; i++) {
        const chip = document.createElement('div');
        chip.className = `soldier-chip ${gameState.dockUsed[i-1] ? 'used' : ''}`;
        chip.innerText = i;
        chip.onclick = () => placeSoldier(i);
        dock.appendChild(chip);
      }

      renderSlots();
    }

    function placeSoldier(val) {
      if (gameState.dockUsed[val-1]) return;
      let emptyIdx = gameState.playerSlots.indexOf(null);
      if (emptyIdx !== -1) {
        gameState.playerSlots[emptyIdx] = val;
        gameState.dockUsed[val-1] = true;
        renderArmory();
      }
    }

    function placeOnSlot(slotIdx) {
      // Se tiver uma arma selecionada, equipa no slot
      if (gameState.selectedWeaponIndex !== null) {
        let w = gameState.playerWeapons[gameState.selectedWeaponIndex];
        gameState.playerWeaponSlots[slotIdx] = w;
        w.used = true;
        gameState.selectedWeaponIndex = null;
        renderArmory();
        return;
      }

      // Se clicar para remover soldado
      if (gameState.playerSlots[slotIdx] !== null) {
        let val = gameState.playerSlots[slotIdx];
        gameState.playerSlots[slotIdx] = null;
        gameState.dockUsed[val-1] = false;
        renderArmory();
      }
    }

    function renderSlots() {
      for (let i = 0; i < 5; i++) {
        const slotEl = document.querySelectorAll('#player-slots .slot')[i];
        let pVal = gameState.playerSlots[i];
        let wVal = gameState.playerWeaponSlots[i];

        let html = '';
        if (pVal !== null) {
          slotEl.classList.add('filled');
          html += `<span class="soldier-badge">${pVal}</span>`;
        } else {
          slotEl.classList.remove('filled');
          html += `<span style="color:#64748b;">${i+1}º</span>`;
        }

        if (wVal) {
          html += `<div class="weapon-badge">${wVal.icon} ${wVal.name}</div>`;
        }
        slotEl.innerHTML = html;
      }

      const allFilled = !gameState.playerSlots.includes(null);
      document.getElementById('start-battle-btn').style.display = allFilled ? 'inline-block' : 'none';
    }

    function startBattle() {
      showScreen('screen-battle');
      const board = document.getElementById('battle-board');
      board.innerHTML = '';

      let pWins = 0;
      let cpuWins = 0;

      for (let i = 0; i < 5; i++) {
        let pBase = gameState.playerSlots[i];
        let cBase = gameState.cpuSlots[i];

        let pWeapon = gameState.playerWeaponSlots[i];
        let cWeapon = gameState.cpuWeaponSlots[i];

        let pScore = pBase;
        let cScore = cBase;

        // Aplica Debuffs (Metralhadora)
        if (pWeapon && pWeapon.id === 'metralhadora') cScore += pWeapon.val;
        if (cWeapon && cWeapon.id === 'metralhadora') pScore += cWeapon.val;

        // Aplica Buffs (Lança, Pistola)
        if (pWeapon && pWeapon.type === 'buff') pScore += pWeapon.val;
        if (cWeapon && cWeapon.type === 'buff') cScore += cWeapon.val;

        let resultText = "";
        let winnerClass = "";

        // Regra da AK-47 (Vitória Direta)
        if (pWeapon && pWeapon.id === 'ak47' && (!cWeapon || cWeapon.id !== 'ak47')) {
          pWins++;
          resultText = "Jogador Vence (AK-47)!";
          winnerClass = "winner";
        } else if (cWeapon && cWeapon.id === 'ak47' && (!pWeapon || pWeapon.id !== 'ak47')) {
          cpuWins++;
          resultText = "CPU Vence (AK-47)!";
          winnerClass = "loser";
        } else {
          // Duelo Padrão por Pontos
          if (pScore > cScore) {
            pWins++;
            resultText = "Jogador Vence!";
            winnerClass = "winner";
          } else if (cScore > pScore) {
            cpuWins++;
            resultText = "CPU Vence!";
            winnerClass = "loser";
          } else {
            // Empate na pontuação final: Sorteio
            if (Math.random() > 0.5) {
              pWins++;
              resultText = "Empate (Sorteio: Jogador)!";
              winnerClass = "winner";
            } else {
              cpuWins++;
              resultText = "Empate (Sorteio: CPU)!";
              winnerClass = "loser";
            }
          }
        }

        const row = document.createElement('div');
        row.className = 'battle-row';
        row.innerHTML = `
          <div class="battle-card player">
            <span style="font-size:0.8rem; color:var(--text-muted);">Você</span>
            <span style="font-size:1.4rem; font-weight:bold;">${pBase}</span>
            <span style="font-size:0.75rem;">${pWeapon ? pWeapon.icon + ' ' + pWeapon.name : 'Sem arma'}</span>
            <span style="font-size:0.85rem; color:var(--accent-gold); margin-top:2px;">Tot: ${pScore}</span>
          </div>
          <span class="vs-badge">VS</span>
          <div class="battle-card cpu">
            <span style="font-size:0.8rem; color:var(--text-muted);">CPU</span>
            <span style="font-size:1.4rem; font-weight:bold;">${cBase}</span>
            <span style="font-size:0.75rem;">${cWeapon ? cWeapon.icon + ' ' + cWeapon.name : 'Sem arma'}</span>
            <span style="font-size:0.85rem; color:var(--accent-gold); margin-top:2px;">Tot: ${cScore}</span>
          </div>
          <div class="result-text ${winnerClass}">${resultText}</div>
        `;
        board.appendChild(row);
      }

      const scoreText = document.getElementById('final-score-text');
      if (pWins > cpuWins) {
        scoreText.innerText = `Vitória! Você eliminou ${pWins} soldados e conquistou a Independência!`;
        scoreText.style.color = "var(--accent-green)";
      } else if (cpuWins > pWins) {
        scoreText.innerText = `Derrota! A CPU venceu ${cpuWins} duelos. Tente novamente!`;
        scoreText.style.color = "var(--accent-red)";
      } else {
        scoreText.innerText = `Empate geral! O conflito terminou equilibrado.`;
        scoreText.style.color = "var(--accent-gold)";
      }

      document.getElementById('final-result-card').style.display = 'block';
    }

    function resetGame() {
      gameState = {
        selectedCountry: null,
        playerWeapons: [],
        cpuWeapons: [],
        playerSlots: [null, null, null, null, null],
        playerWeaponSlots: [null, null, null, null, null],
        cpuSlots: [1, 2, 3, 4, 5],
        cpuWeaponSlots: [null, null, null, null, null],
        selectedWeaponIndex: null,
        dockUsed: [false, false, false, false, false]
      };
      showScreen('screen-start');
    }
  </script>
</body>

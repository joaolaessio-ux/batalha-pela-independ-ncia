<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Batalha pela Independência</title>
  <style>
    :root {
      --bg-dark: #0f172a;
      --card-bg: #1e293b;
      --accent-gold: #f59e0b;
      --accent-red: #ef4444;
      --accent-green: #10b981;
      --accent-blue: #3b82f6;
      --text-light: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-light);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .screen {
      display: none;
      width: 100%;
      max-width: 900px;
      background: var(--card-bg);
      border-radius: 16px;
      padding: 30px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.1);
      text-align: center;
    }

    .screen.active {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    h1 {
      font-size: 2.5rem;
      color: var(--accent-gold);
      margin-bottom: 20px;
      text-transform: uppercase;
      letter-spacing: 2px;
      text-shadow: 0 2px 10px rgba(245, 158, 11, 0.3);
    }

    /* Start Screen */
    .map-container {
      width: 100%;
      max-width: 600px;
      margin: 20px 0;
      border-radius: 12px;
      overflow: hidden;
      border: 2px solid var(--accent-gold);
      box-shadow: 0 0 20px rgba(245, 158, 11, 0.2);
    }

    .map-container svg {
      width: 100%;
      height: auto;
      display: block;
      background: #0284c7;
    }

    .btn-group {
      display: flex;
      gap: 20px;
      margin-top: 20px;
    }

    .btn {
      padding: 14px 32px;
      font-size: 1.1rem;
      font-weight: bold;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      text-transform: uppercase;
    }

    .btn-primary {
      background: var(--accent-gold);
      color: #000;
    }

    .btn-primary:hover {
      background: #d97706;
      transform: translateY(-2px);
    }

    .btn-danger {
      background: var(--accent-red);
      color: #fff;
    }

    .btn-danger:hover {
      background: #dc2626;
      transform: translateY(-2px);
    }

    /* Roulette Screen */
    .roulette-wrapper {
      position: relative;
      width: 320px;
      height: 320px;
      margin: 20px auto;
    }

    .roulette-wheel {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 6px solid var(--accent-gold);
      box-shadow: 0 0 25px rgba(245, 158, 11, 0.4);
      transition: transform 5s cubic-bezier(0.15, 0.9, 0.15, 1);
      background: conic-gradient(
        #ef4444 0deg 30deg, #3b82f6 30deg 60deg, #10b981 60deg 90deg, 
        #f59e0b 90deg 120deg, #8b5cf6 120deg 150deg, #ec4899 150deg 180deg,
        #06b6d4 180deg 210deg, #84cc16 210deg 240deg, #eab308 240deg 270deg,
        #f97316 270deg 300deg, #6366f1 300deg 330deg, #14b8a6 330deg 360deg
      );
    }

    .roulette-pointer {
      position: absolute;
      top: -15px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 15px solid transparent;
      border-right: 15px solid transparent;
      border-top: 25px solid var(--accent-gold);
      z-index: 10;
    }

    .history-card {
      background: rgba(15, 23, 42, 0.8);
      border-left: 4px solid var(--accent-gold);
      padding: 20px;
      border-radius: 8px;
      margin: 20px 0;
      text-align: left;
      width: 100%;
      display: none;
    }

    .history-card.active {
      display: block;
    }

    .history-card h3 {
      color: var(--accent-gold);
      margin-bottom: 10px;
    }

    .history-card p {
      margin: 6px 0;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    /* Weapon Cards */
    .weapons-container {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin: 20px 0;
      flex-wrap: wrap;
    }

    .weapon-card {
      background: #334155;
      border: 2px solid var(--accent-gold);
      border-radius: 8px;
      padding: 10px;
      width: 130px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
    }

    .weapon-card.selected {
      border-color: var(--accent-green);
      box-shadow: 0 0 10px var(--accent-green);
      transform: scale(1.05);
    }

    .weapon-card.used {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .weapon-icon {
      font-size: 1.8rem;
      margin-bottom: 5px;
    }

    .weapon-name {
      font-weight: bold;
      font-size: 0.9rem;
    }

    .weapon-effect {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* Positioning Board */
    .board-container {
      display: flex;
      flex-direction: column;
      gap: 30px;
      width: 100%;
      margin: 20px 0;
    }

    .side-title {
      font-weight: bold;
      color: var(--text-muted);
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .slots-row {
      display: flex;
      justify-content: center;
      gap: 15px;
    }

    .slot {
      width: 100px;
      height: 130px;
      background: rgba(15, 23, 42, 0.6);
      border: 2px dashed #475569;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      transition: all 0.3s;
    }

    .slot.filled {
      border-style: solid;
      border-color: var(--accent-blue);
      background: #1e293b;
    }

    .slot.cpu-slot {
      border-color: var(--accent-red);
    }

    .soldier-badge {
      font-size: 1.5rem;
      font-weight: bold;
      color: var(--accent-gold);
    }

    .weapon-badge {
      position: absolute;
      bottom: 5px;
      font-size: 0.75rem;
      background: rgba(0,0,0,0.6);
      padding: 2px 6px;
      border-radius: 4px;
    }

    .soldiers-dock {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-top: 15px;
    }

    .soldier-chip {
      width: 50px;
      height: 50px;
      background: var(--accent-blue);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 1.2rem;
      cursor: pointer;
      border: 2px solid #fff;
    }

    .soldier-chip.used {
      opacity: 0.3;
      cursor: not-allowed;
    }

    /* Battle Screen */
    .battle-row {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 15px;
      margin: 10px 0;
      padding: 10px;
      background: rgba(15, 23, 42, 0.4);
      border-radius: 8px;
      width: 100%;
    }

    .battle-card {
      width: 90px;
      height: 110px;
      background: #1e293b;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border: 2px solid #475569;
    }

    .battle-card.player { border-color: var(--accent-blue); }
    .battle-card.cpu { border-color: var(--accent-red); }

    .vs-badge {
      font-weight: bold;
      color: var(--accent-gold);
    }

    .result-text {
      width: 150px;
      font-weight: bold;
      font-size: 0.9rem;
    }

    .winner { color: var(--accent-green); }
    .loser { color: var(--accent-red); }
    .draw { color: var(--accent-gold); }

    /* Result Modal */
    .final-score {
      font-size: 2rem;
      margin: 20px 0;
      color: var(--accent-gold);
    }
  </style>
</head>
<body>

  <!-- 1. TELA INICIAL -->
  <div id="screen-start" class="screen active">
    <h1>Batalha pela Independência</h1>
    <div class="map-container">
      <svg viewBox="0 0 1000 500">
        <path d="M150,150 Q200,100 250,150 T350,150 T450,200" fill="none" stroke="#22c55e" stroke-width="40" opacity="0.3"/>
        <path d="M700,150 Q800,100 850,200 T750,300" fill="none" stroke="#22c55e" stroke-width="50" opacity="0.3"/>
        <text x="500" y="250" fill="#ffffff" font-size="28" text-anchor="middle" font-weight="bold">MAPA MÚNDI</text>
      </svg>
    </div>
    <div class="btn-group">
      <button class="btn btn-primary" onclick="startRoulettePhase()">Iniciar</button>
      <button class="btn btn-danger" onclick="exitGame()">Sair</button>
    </div>
  </div>

  <!-- 2. TELA DA ROLETA -->
  <div id="screen-roulette" class="screen">
    <h1>Sorteio de Nação</h1>
    <div class="roulette-wrapper">
      <div class="roulette-pointer"></div>
      <div id="wheel" class="roulette-wheel"></div>
    </div>
    <button id="spin-btn" class="btn btn-primary" onclick="spinWheel()">Girar Roleta</button>

    <div id="history-card" class="history-card">
      <h3 id="country-name">País</h3>
      <p><strong>Ano da Independência:</strong> <span id="indep-year"></span></p>
      <p><strong>Oponente Principal:</strong> <span id="rival-name"></span></p>
      <p id="country-story" style="margin-top: 10px; color: var(--text-muted);"></p>
      <button class="btn btn-primary" style="margin-top: 15px;" onclick="goToArmory()">Avançar para Estratégia</button>
    </div>
  </div>

  <!-- 3. TELA DE ARMAS E POSICIONAMENTO -->
  <div id="screen-positioning" class="screen">
    <h1>Posicionamento Tático</h1>
    
    <p>Suas Armas Sorteadas (Clique para selecionar e depois em um soldado):</p>
    <div id="player-weapons" class="weapons-container"></div>

    <div class="board-container">
      <div>
        <div class="side-title">Seus Soldados</div>
        <div class="slots-row" id="player-slots">
          <div class="slot" onclick="placeOnSlot(0)"><span class="soldier-badge">1</span></div>
          <div class="slot" onclick="placeOnSlot(1)"><span class="soldier-badge">2</span></div>
          <div class="slot" onclick="placeOnSlot(2)"><span class="soldier-badge">3</span></div>
          <div class="slot" onclick="placeOnSlot(3)"><span class="soldier-badge">4</span></div>
          <div class="slot" onclick="placeOnSlot(4)"><span class="soldier-badge">5</span></div>
        </div>
      </div>
    </div>

    <p>Escolha a ordem dos seus soldados (1 a 5):</p>
    <div class="soldiers-dock" id="soldiers-dock"></div>

    <button id="start-battle-btn" class="btn btn-primary" style="margin-top:20px; display:none;" onclick="startBattle()">Iniciar Batalha</button>
  </div>

  <!-- 4. TELA DE BATALHA -->
  <div id="screen-battle" class="screen">
    <h1>Confronto Final</h1>
    <div id="battle-board" style="width: 100%;"></div>
    <div id="final-result-card" style="display:none; margin-top:20px;">
      <div class="final-score" id="final-score-text"></div>
      <button class="btn btn-primary" onclick="resetGame()">Jogar Novamente</button>
    </div>
  </div>

